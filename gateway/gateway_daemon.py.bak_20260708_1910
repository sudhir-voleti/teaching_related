import sys
import os
import time
import json
import re
import urllib.request

sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
from tools.global_utils import (
    AGENTMAIL_KEY, INBOX_ID, query_omlx_llm, send_agentmail_packet,
    read_asset_file, query_course_ledger, send_student_email, log_to_terminal,
    send_bulk_campaign, email_inventory_manifest
)

LOG_FILE = "/Users/sudhirvoleti/teaching_trials/courses/MTGT1/marketing-agent-os/gateway/processed_emails.txt"
SKILLS_DIR = "/Users/sudhirvoleti/teaching_trials/courses/MTGT1/marketing-agent-os/skills"
WHITELIST_FILE = "/Users/sudhirvoleti/teaching_trials/courses/MTGT1/marketing-agent-os/assets/email-id-whitelist.txt"

def get_processed_ids():
    if not os.path.exists(LOG_FILE): return set()
    with open(LOG_FILE, "r") as f: return set(line.strip() for line in f if line.strip())

def mark_id_as_processed(msg_id):
    with open(LOG_FILE, "a") as f: f.write(f"{msg_id}\n")

def is_email_whitelisted(email_address):
    if not os.path.exists(WHITELIST_FILE): return True
    with open(WHITELIST_FILE, "r") as f:
        whitelist = set(line.strip().lower() for line in f if line.strip())
    return email_address.strip().lower() in whitelist

def sync_initial_backlog():
    print("🔄 Initializing daemon baseline sync...")
    url = f"https://api.agentmail.to/v0/inboxes/{INBOX_ID}/messages"
    try:
        req = urllib.request.Request(url, headers={"Authorization": f"Bearer {AGENTMAIL_KEY}"})
        with urllib.request.urlopen(req, timeout=10) as response:
            res_json = json.loads(response.read().decode('utf-8'))
        
        current_ids = get_processed_ids()
        new_sync_count = 0
        for msg in res_json.get("messages", []):
            sender = msg.get("from", "")
            msg_id = msg.get("message_id", msg.get("id", f"{sender}")).strip()
            if msg_id and msg_id not in current_ids:
                mark_id_as_processed(msg_id)
                new_sync_count += 1
        print(f"✅ Baseline set. Muted {new_sync_count} backlog items.")
    except Exception as e:
        print(f"⚠️ Sync skipped: {str(e)}")

def execute_cognitive_loop(cargo, target_model, user_email):
    print(f"\n🦅 [Loop Init] Streamlined Re-Act Engine: {target_model}")
    
    skill_match = re.search(r'(?:execute\s+the\s+|execute_skill:\s*)([\w_]+)', cargo, re.IGNORECASE)
    skill_context = ""
    
    if skill_match:
        skill_id = skill_match.group(1).lower()
        skill_file_path = os.path.join(SKILLS_DIR, f"{skill_id}.json")
        print(f"📂 [Daemon Ingestion] Scanning target path: {skill_file_path}")
        
        if os.path.exists(skill_file_path):
            with open(skill_file_path, "r") as sf:
                skill_context = f"\nCRITICAL INSTRUCTION: Execute this exact recipe sequence step-by-step:\n{sf.read()}"
                print(f"📋 [Skill Ingestion] SUCCESS: Loaded recipe {skill_id.upper()}")
        else:
            print(f"❌ [Skill Ingestion] ERROR: Blueprint file missing on disk at {skill_file_path}")
            # Inject defensive fallback context directly to the model to prevent infinite loop confusion
            skill_context = f"\nSYSTEM ERROR: The requested skill '{skill_id}' was not found on disk. Call terminate_session('Skill file missing') immediately."

    system_prompt = f"""You are a tool execution core. You must output tool actions using standard naming formatting:
TOOL_RUN: tool_name(args)

Available execution actions:
- TOOL_RUN: read_asset_file("filename")
- TOOL_RUN: query_course_ledger("SELECT ...")
- TOOL_RUN: send_bulk_campaign("table_name", "Subject", "attachment_file")
- TOOL_RUN: send_student_email("email", "Subject", "Body")
- TOOL_RUN: email_inventory_manifest("recipient_email")
- TOOL_RUN: log_to_terminal("Message")
- TOOL_RUN: terminate_session("Summary status report text")
{skill_context}

Output ONLY the tool block execution command string. Do not wrap in markdown syntax or add conversational text."""

    history = [{"role": "user", "content": cargo}]
    
    for turn in range(12):
        print(f"\n🧠 [{target_model}] Turn {turn+1} processing...")
        start_time = time.perf_counter()
        
        response_text = query_omlx_llm(
            model_name=target_model,
            system_prompt=system_prompt,
            user_prompt=json.dumps(history),
            temperature=0.0
        ).strip()
        
        elapsed = time.perf_counter() - start_time
        print(f"⏱️  [Telemetry] Raw Out: \"{response_text}\" ({elapsed:.2f}s)")
        
        tool_match = re.search(r'(?:TOOL_RUN:|CALL_TOOL:)?\s*(\w+)\((.*)\)', response_text, re.IGNORECASE)
        if tool_match:
            tool_name = tool_match.group(1).lower().strip()
            raw_args = tool_match.group(2)
            
            try:
                args = json.loads("[" + raw_args + "]")
            except:
                args = [arg.strip('"\' ') for arg in re.split(r',(?=(?:[^"\']*["\'][^"\']*["\'])*[^"\']*$)', raw_args)]
            
            if tool_name in ["terminate_session", "terminate_loop"]:
                print("\n🏁 [EXECUTION DISPATCH TERMINATED NATIVELY]")
                summary = args[0] if args else "Complete."
                print(f"📊 [Final Status Report]: {summary}\n")
                send_agentmail_packet(user_email, "Agent OS: Process Final Report", f"Terminated cleanly.\nSummary: {summary}")
                break
                
            print(f"🛠️  [Invoking] {tool_name}({args})")
            if tool_name == "read_asset_file": tool_result = read_asset_file(args[0])
            elif tool_name == "query_course_ledger": tool_result = query_course_ledger(args[0])
            elif tool_name == "send_bulk_campaign": tool_result = send_bulk_campaign(args[0], args[1], args[2])
            elif tool_name == "send_student_email": tool_result = send_student_email(args[0], args[1], args[2])
            elif tool_name == "email_inventory_manifest": tool_result = email_inventory_manifest(args[0])
            elif tool_name == "log_to_terminal": tool_result = log_to_terminal(args[0])
            else: tool_result = f"Error: Tool {tool_name} unknown."
            
            history.append({"role": "assistant", "content": f"TOOL_RUN: {tool_name}({', '.join(args)})"})
            history.append({"role": "user", "content": f"Result:\n{tool_result}"})
            continue
            
        print("⚠️ Parsing structural gap. Forcing continuation token alignment.")
        history.append({"role": "user", "content": "Syntax Error. Output your next tool call exactly as: TOOL_RUN: tool_name(args)"})

def check_inbound_commands():
    url = f"https://api.agentmail.to/v0/inboxes/{INBOX_ID}/messages"
    try:
        req = urllib.request.Request(url, headers={"Authorization": f"Bearer {AGENTMAIL_KEY}"})
        with urllib.request.urlopen(req, timeout=10) as response:
            res_json = json.loads(response.read().decode('utf-8'))
        
        processed_ids = get_processed_ids()
        for msg in res_json.get("messages", []):
            sender = msg.get("from", "").strip()
            msg_id = msg.get("message_id", msg.get("id", f"{sender}")).strip()
            
            if msg_id in processed_ids: continue
            
            email_match = re.search(r'[\w\.-]+@[\w\.-]+', sender)
            user_email = email_match.group(0) if email_match else ""
            if not user_email or not is_email_whitelisted(user_email):
                mark_id_as_processed(msg_id)
                continue
                
            print(f"\n🔥 [Intercepted Authorized Signal]: {msg_id} from {user_email}")
            mark_id_as_processed(msg_id)
            
            raw_body = msg.get("text", msg.get("preview", ""))
            body = re.split(r"(?i)-+\s*original\s+message\s*-+|on\s+.*wrote:", raw_body)[0].strip()
            
            selected_model = "Qwen3.6-35B-A3B-4bit" if "qwen" in body.lower() else "Ornith-1.0-9B-oQ4-fp16"
            execute_cognitive_loop(body, selected_model, user_email)
            break
    except Exception as e:
        print(f"⚠️ Polling Hiccup: {str(e)}")

if __name__ == "__main__":
    print("📡 MATRIX SYSTEM LIVE: STREAMLINED MODEL ROUTING ACTIVATED...")
    sync_initial_backlog()
    while True:
        check_inbound_commands()
        time.sleep(10)
