DB_PATH = "/Users/sudhirvoleti/teaching_trials/courses/MTGT1/db/MTGT1-ledger.db"

def load_env_variable(key_name, default_value="omlx-local"):
    """Reads secret tokens from the local hidden .env file manually without external libraries."""
    env_path = "/Users/sudhirvoleti/teaching_trials/courses/MTGT1/marketing-agent-os/.env"
    if not os.path.exists(env_path):
        return default_value
    try:
        with open(env_path, "r") as f:
            for line in f:
                if line.strip().startswith(key_name):
                    parts = line.split("=", 1)
                    if len(parts) == 2:
                        return parts[1].strip().strip('"').strip("'")
    except Exception:
        pass
    return default_value

OMLX_KEY = load_env_variable("OMLX_API_KEY")
AGENTMAIL_KEY = load_env_variable("AGENTMAIL_API_KEY")
INBOX_ID = load_env_variable("AGENTMAIL_INBOX_ID")

def query_omlx_llm(model_name, system_prompt, user_prompt, temperature=0.3):
    """Universal helper to communicate with locally hosted vLLM engines."""
    url = "http://127.0.0.1:8000/v1/chat/completions"
    payload = {
        "model": model_name,
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_prompt}
        ],
        "temperature": temperature
    }
    try:
        req = urllib.request.Request(
            url, data=json.dumps(payload).encode('utf-8'),
            headers={"Content-Type": "application/json", "Authorization": f"Bearer {OMLX_KEY}"},
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=30) as response:
            res = json.loads(response.read().decode('utf-8'))
            return res['choices'][0]['message']['content'].strip()
    except Exception as e:
        return f"LLM Generation Error: {str(e)}"

def send_agentmail_packet(to_email, subject, body_content):
    """Universal outbound helper to dispatch tracking messages via AgentMail."""
    url = f"https://api.agentmail.to/v0/inboxes/{INBOX_ID}/messages/send"
    payload = {
        "to": to_email,
        "subject": subject,
        "text": body_content
    }
    
    if AGENTMAIL_KEY == "omlx-local":
        print(f"   📊 [Sandbox Simulation] Packet routed to carrier routing array for: {to_email}")
        return True, "Simulated network handshake clear."
        
    try:
        req = urllib.request.Request(
            url, data=json.dumps(payload).encode('utf-8'),
            headers={
                "Content-Type": "application/json", 
                "Authorization": f"Bearer {AGENTMAIL_KEY}"
            },
            method="POST"
        )
        with urllib.request.urlopen(req, timeout=10) as response:
            return True, "Email successfully queued with backend relay."
    except Exception as e:
        return False, str(e)

# --- Native Execution Tools For Skills Pipeline ---
import os
import json
import sqlite3

ASSETS_DIR = "/Users/sudhirvoleti/teaching_trials/courses/MTGT1/marketing-agent-os/assets"

def read_asset_file(filename):
    safe_path = os.path.join(ASSETS_DIR, os.path.basename(filename))
    if not os.path.exists(safe_path): return f"Error: Asset file {filename} not found."
    try:
        with open(safe_path, "r", encoding="utf-8") as f: return f.read()
    except Exception as e: return f"Error reading file: {str(e)}"

def query_course_ledger(sql_command):
    # DB_PATH is already defined at the top of global_utils.py
    if not os.path.exists(DB_PATH): return f"Error: Database file not found at {DB_PATH}"
    if not sql_command.strip().lower().startswith("select"): return "Security block: Only SELECT queries permitted."
    try:
        conn = sqlite3.connect(DB_PATH)
        cursor = conn.cursor()
        cursor.execute(sql_command)
        rows = cursor.fetchall()
        colnames = [desc[0] for desc in cursor.description]
        conn.close()
        return json.dumps([dict(zip(colnames, row)) for row in rows], indent=2)
    except Exception as e: return f"Database error: {str(e)}"

def send_student_email(to_email, subject, body):
    # send_agentmail_packet is already defined in global_utils.py
    success, msg = send_agentmail_packet(to_email, subject, body)
    if success: return f"Success: Email queued for {to_email}."
    return f"Network Error sending to {to_email}: {msg}"

def log_to_terminal(message):
    print(f"📺 [AGENT TELEMETRY LOG]: {message}")
    return "Log output displayed successfully on terminal."

# --- Upgraded Enterprise Execution Tools ---
def send_student_email_with_attachment(to_email, subject, body_text, attachment_file=None):
    """Sends an email with an optional asset attachment path cleanly parsed."""
    payload = body_text
    if attachment_file:
        asset_path = os.path.join("/Users/sudhirvoleti/teaching_trials/courses/MTGT1/marketing-agent-os/assets", attachment_file)
        if os.path.exists(asset_path):
            with open(asset_path, "r", encoding="utf-8") as f:
                payload += f"\n\n[Attached Asset: {attachment_file}]\n" + f.read()
    
    success, msg = send_agentmail_packet(to_email, subject, payload)
    if success: return f"Success: Email dispatched to {to_email}."
    return f"Error sending to {to_email}: {msg}"



def send_bulk_campaign(table_name, subject, attachment_file=None):
    """Executes a true bulk database compilation with aggressive console telemetry."""
    # Explicitly use the database we verified on disk
    target_db = "/Users/sudhirvoleti/teaching_trials/courses/MTGT1/marketing-agent-os/db/course_data.db"
    print(f"📁 [Bulk Engine] Verifying database connection at: {target_db}")
    
    if not os.path.exists(target_db):
        print("❌ [Bulk Engine] ERROR: Database file does not exist at that path.")
        return "Error: Database file missing."
        
    try:
        conn = sqlite3.connect(target_db)
        cursor = conn.cursor()
        
        print(f"🔍 [Bulk Engine] Querying table: {table_name}")
        cursor.execute(f"SELECT DISTINCT student_name, email FROM {table_name};")
        rows = cursor.fetchall()
        conn.close()
        
        print(f"📊 [Bulk Engine] Found {len(rows)} matching recipient rows in database.")
        if not rows:
            return "Warning: Campaign target table returned 0 rows."
            
        dispatched = 0
        for name, email in rows:
            print(f"📧 [Bulk Engine] Dispatching email packet to: {name} ({email})")
            body = f"Dear {name},\n\nPlease find your course welcome materials attached below."
            send_student_email_with_attachment(email, subject, body, attachment_file)
            dispatched += 1
            
        print(f"✅ [Bulk Engine] Successfully processed {dispatched} network dispatches.")
        return f"Success: Dispatched {dispatched} emails natively."
    except Exception as e:
        print(f"💥 [Bulk Engine] Critical SQL/Network exception: {str(e)}")
        return f"Bulk processing failed: {str(e)}"

def email_inventory_manifest(recipient_email):
    """Compiles local tool definitions and available skill configurations, sending the blueprint map over email."""
    tools_path = "/Users/sudhirvoleti/teaching_trials/courses/MTGT1/marketing-agent-os/tools/global_utils.py"
    skills_dir = "/Users/sudhirvoleti/teaching_trials/courses/MTGT1/marketing-agent-os/skills"
    
    manifest_text = "🛰️ MARKETING AGENT OS: SYSTEM INVENTORY MANIFEST\\n"
    manifest_text += "===============================================\\n\\n"
    
    # Extract Python tool function headers
    manifest_text += "🛠️ AVAILABLE CORE PYTHON EXECUTION TOOLS:\\n"
    if os.path.exists(tools_path):
        with open(tools_path, "r") as f:
            for line in f:
                if line.strip().startswith("def "):
                    manifest_text += f"  - {line.strip()}\\n"
    
    # Extract JSON recipe structures
    manifest_text += "\\n📋 INSTALLED DISK SKILL RECIPES:\\n"
    if os.path.exists(skills_dir):
        for file in os.listdir(skills_dir):
            if file.endswith(".json"):
                manifest_text += f"  - {file}\\n"
                
    success, msg = send_agentmail_packet(recipient_email, "Agent OS: System Inventory Manifest", manifest_text)
    if success: return "Success: Manifest compiled and dispatched to your inbox."
    return f"Error mailing manifest: {msg}"

