# === New Utilities for Lecture & Student Management ===

def list_available_assets(subdir=""):
    """List assets for inventory or dynamic loading."""
    target_dir = os.path.join(ASSETS_DIR, subdir) if subdir else ASSETS_DIR
    if not os.path.exists(target_dir):
        return "[]"
    files = [f for f in os.listdir(target_dir) if not f.startswith('.')]
    return json.dumps(files, indent=2)

def get_student_profile(student_email):
    """Fetch profile from student folders or DB."""
    # Simple folder-based first
    safe_email = student_email.replace('@', '_at_').replace('.', '_')
    profile_path = f"/Users/sudhirvoleti/teaching_trials/courses/MTGT1/students/{safe_email}/student-profile.json"
    if os.path.exists(profile_path):
        with open(profile_path, "r") as f:
            return json.load(f)
    # Fallback to DB query
    return query_course_ledger(f"SELECT * FROM students WHERE email = '{student_email}' LIMIT 1")

def generate_lecture_summary(lecture_table):
    """Quick stats on submissions."""
    sql = f"""
        SELECT 
            COUNT(*) as total,
            SUM(CASE WHEN status = 'SUBMITTED' THEN 1 ELSE 0 END) as submitted,
            SUM(CASE WHEN status = 'GRADED' THEN 1 ELSE 0 END) as graded
        FROM {lecture_table}
    """
    return query_course_ledger(sql)

