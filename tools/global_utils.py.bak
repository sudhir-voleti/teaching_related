    """Housekeeping: move processed emails older than N days."""
    cutoff = (datetime.datetime.now() - datetime.timedelta(days=days_old)).isoformat()
    # Add your archiving logic here if needed
    return f"Archiving policy applied for items older than {days_old} days."

# === Enhanced Bulk & Reporting Tools ===

def send_personalized_bulk(table_name, subject_template, body_template, attachment_file=None):
    """More flexible bulk with templating (name substitution)."""
    target_db = "/Users/sudhirvoleti/teaching_trials/courses/MTGT1/marketing-agent-os/db/course_data.db"
    conn = sqlite3.connect(target_db)
    cursor = conn.cursor()
    cursor.execute(f"SELECT student_name, email FROM {table_name};")
    rows = cursor.fetchall()
    conn.close()
    
    dispatched = 0
    for name, email in rows:
        body = body_template.replace("{{name}}", name)
        subject = subject_template.replace("{{name}}", name)
        send_student_email_with_attachment(email, subject, body, attachment_file)
        dispatched += 1
    return f"Personalized campaign dispatched to {dispatched} students."

